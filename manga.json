438\u043b\u044c\u043d\u044b, \u0431\u044b\u0441\u0442\u0440\u044b \u0438 \u0436\u0438\u0432\u0443\u0447\u0438 - \u043d\u043e \u0438\u0445 \u043c\u0430\u043b\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0433\u0443\u043b\u0438 \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u0441\u0442\u0440\u043e\u0433\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043e\u0445\u043e\u0442\u044b \u0438 \u043c\u0430\u0441\u043a\u0438\u0440\u043e\u0432\u043a\u0438, \u0430 \u043d\u0430\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u0435\u0439 \u043d\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0441\u0430\u043c\u0438 \u0438\u043b\u0438 \u043f\u043e-\u0442\u0438\u0445\u043e\u043c\u0443 \u0441\u0434\u0430\u044e\u0442 \u0431\u043e\u0440\u0446\u0430\u043c \u0441 \u043d\u0435\u0447\u0438\u0441\u0442\u044c\u044e. \u0412 \u0432\u0435\u043a \u043d\u0430\u0443\u043a\u0438 \u043b\u044e\u0434\u0438 \u0437\u043d\u0430\u044e\u0442 \u043f\u0440\u043e \u0433\u0443\u043b\u0435\u0439, \u043d\u043e \u043a\u0430\u043a \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f, \u043f\u0440\u0438\u0432\u044b\u043a\u043b\u0438. \u0412\u043b\u0430\u0441\u0442\u0438 \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043b\u044e\u0434\u043e\u0435\u0434\u043e\u0432 \u0443\u0433\u0440\u043e\u0437\u043e\u0439, \u0431\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e\u0442 \u0438\u0445 \u043a\u0430\u043a \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u0443\u044e \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0441\u0443\u043f\u0435\u0440\u0441\u043e\u043b\u0434\u0430\u0442. \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b \u0438\u0434\u0443\u0442 \u0443\u0436\u0435 \u0434\u0430\u0432\u043d\u043e\u2026  \n  \n\u041d\u0438\u0447\u0435\u0433\u043e \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u043b \u041a\u0430\u043d\u044d\u043a\u0438 \u041a\u044d\u043d, \u0440\u043e\u0431\u043a\u0438\u0439 \u0438 \u043d\u0435\u0432\u0437\u0440\u0430\u0447\u043d\u044b\u0439 \u0442\u043e\u043a\u0438\u0439\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0432\u043e\u043a\u0443\u0440\u0441\u043d\u0438\u043a, \u0431\u0435\u0437\u043d\u0430\u0434\u0435\u0436\u043d\u043e \u0432\u043b\u044e\u0431\u043b\u0435\u043d\u043d\u044b\u0439 \u0432 \u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0443-\u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u043a\u0443 \u0420\u0438\u0437\u044d, \u0447\u0430\u0441\u0442\u0443\u044e \u0433\u043e\u0441\u0442\u044c\u044e \u0432 \u043a\u0430\u0444\u0435 \u00ab\u041c\u0435\u0441\u0442\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0438\u00bb, \u0433\u0434\u0435 \u043f\u0430\u0440\u0435\u043d\u044c \u043f\u043e\u0434\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043e\u0444\u0438\u0446\u0438\u0430\u043d\u0442\u043e\u043c. \u041d\u0435 \u0434\u0443\u043c\u0430\u043b \u041a\u044d\u043d, \u0447\u0442\u043e \u0441\u043a\u043e\u0440\u043e \u0441\u0430\u043c\u043e\u043c\u0443 \u043f\u0440\u0438\u0434\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u0442\u044c \u0433\u0443\u043b\u0435\u043c, \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u043d\u0443\u0442 \u0432 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u043c \u0441\u0432\u0435\u0442\u0435. \u0413\u043b\u0430\u0432\u043d\u043e\u043c\u0443 \u0433\u0435\u0440\u043e\u044e \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u0438\u0442 \u043c\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0438\u0441\u043a \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u0443\u0442\u0438, \u0438\u0431\u043e \u043e\u043d \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043b\u044e\u0434\u0438 \u0438 \u0433\u0443\u043b\u0438 \u043f\u043e\u0445\u043e\u0436\u0438: \u043f\u0440\u043e\u0441\u0442\u043e \u043e